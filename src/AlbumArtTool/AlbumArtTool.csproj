<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AlbumArtTool</AssemblyName>
    <RootNamespace>AlbumArtTool</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Ahead-of-time compiled: no JIT at startup and a small self-contained install. -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.*" />
    <ProjectReference Include="../AlbumArtTool.Core/AlbumArtTool.Core.csproj" />
    <!-- TagLibSharp creates its file readers through reflection; keep the whole library. -->
    <TrimmerRootAssembly Include="TagLibSharp" />
    <AvaloniaResource Include="Assets/AppIcon.ico" />
    <InternalsVisibleTo Include="AlbumArtTool.Tests" />
  </ItemGroup>
</Project>
